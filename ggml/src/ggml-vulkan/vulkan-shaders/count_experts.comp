#version 450

#extension GL_EXT_control_flow_attributes : enable

#include "types.glsl"

layout (push_constant) uniform parameter
{
    uint32_t ne00;
    uint32_t ne01;
    uint32_t nb00;
    uint32_t nb01;
    uint32_t a_offset;
    // GGML_VK_MMID_INDIRECT_EARLY: when args_off != 0, fold ceil(count / bn) into the matmul's dispatch args at
    // data_d[args_off] (y zeroed by the host before this pass): one workgroup per expert knows its whole count
    uint32_t args_off;
    uint32_t gx;
    uint32_t bn;
    // MUL_MAT_ID -1 ids (upstream #26631): the matmul writes only the rows an expert owns, so this pass zeroes the
    // dst rows of the skipped slots. ne0_dst elements per row, strides in dst elements, dst_f16 for f16 stores
    uint32_t ne0_dst;
    uint32_t stride_dst;
    uint32_t batch_stride_dst;
    uint32_t dst_f16;
} p;

#define BLOCK_SIZE 256

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {uint data_a[];};
layout (binding = 1) buffer D {uint data_d[];};
layout (binding = 2) writeonly buffer DST {float data_dst[];};
layout (binding = 2) writeonly buffer DST16 {uint16_t data_dst16[];};

shared uint vals[BLOCK_SIZE];
shared uint negs[BLOCK_SIZE];
shared uint skipped[BLOCK_SIZE];

// zero the dst rows of the skipped slots (negative ids). The workgroups split the slots in chunks of BLOCK_SIZE, each
// thread checks one slot id of the chunk, then the whole workgroup zeroes each skipped row of the chunk.
// Called in workgroup-uniform control flow only (barriers)
void zero_skipped_rows() {
    const uint num_elements = p.ne00 * p.ne01;
    const uint tid = gl_LocalInvocationID.x;
    for (uint base = gl_WorkGroupID.x * BLOCK_SIZE; base < num_elements; base += gl_NumWorkGroups.x * BLOCK_SIZE) {
        const uint idx = base + tid;
        uint skip = 0;
        if (idx < num_elements) {
            const uint i01 = idx / p.ne00;
            const uint i00 = idx % p.ne00;
            skip = uint(int(data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00]) < 0);
        }
        skipped[tid] = skip;
        barrier();
        for (uint j = 0; j < BLOCK_SIZE; j++) {
            if (skipped[j] == 0) {
                continue;
            }
            const uint i01 = (base + j) / p.ne00;
            const uint i00 = (base + j) % p.ne00;
            const uint d_off = i00 * p.stride_dst + i01 * p.batch_stride_dst;
            if (p.dst_f16 != 0) {
                for (uint i = tid; i < p.ne0_dst; i += BLOCK_SIZE) {
                    data_dst16[d_off + i] = uint16_t(0);
                }
            } else {
                for (uint i = tid; i < p.ne0_dst; i += BLOCK_SIZE) {
                    data_dst[d_off + i] = 0.0;
                }
            }
        }
        barrier();
    }
}

void main() {
    const uint expert_id = gl_WorkGroupID.x;
    const uint num_elements = p.ne00 * p.ne01;
    const uint tid = gl_LocalInvocationID.x;

    uint count = 0;
    uint neg = 0;
    for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
        const uint i01 = idx / p.ne00;
        const uint i00 = idx % p.ne00;
        const uint a = data_a[p.a_offset + i01 * p.nb01 + i00 * p.nb00];

        count += uint(a == expert_id);
        neg |= uint(int(a) < 0);
    }

    // each workgroup reads every id, so each one learns whether any slot is skipped
    vals[tid] = count;
    negs[tid] = neg;
    barrier();
    [[unroll]] for (uint s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            vals[tid] += vals[tid + s];
            negs[tid] |= negs[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        data_d[expert_id] = vals[0];
        if (p.args_off != 0) {
            atomicMax(data_d[p.args_off + 1], (vals[0] + p.bn - 1) / p.bn);
            if (expert_id == 0) {
                data_d[p.args_off]     = p.gx;
                data_d[p.args_off + 2] = gl_NumWorkGroups.x;
            }
        }
    }

    if (p.ne0_dst != 0 && negs[0] != 0) {
        zero_skipped_rows();
    }
}
